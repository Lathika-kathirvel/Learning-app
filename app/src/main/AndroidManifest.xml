<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet permission for Firebase and AI API -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.LearningApp">

        <!-- HR Interview -->
        <activity
            android:name=".HRInterviewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- AI Resume Interview -->
        <activity
            android:name=".AIResumeInterviewActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- AI Interview Analysis -->
        <activity
            android:name=".AIInterviewAnalysisActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Aptitude Setup -->
        <activity
            android:name=".AptitudeSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Aptitude Questions -->
        <activity
            android:name=".AptitudeQuestionsActivity"
            android:exported="false" />

        <!-- Aptitude Result -->
        <activity
            android:name=".AptitudeResultActivity"
            android:exported="false" />

        <!-- Technical Interview Setup -->
        <activity
            android:name=".TechnicalInterviewSetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Generated Technical Questions -->
        <activity
            android:name=".GeneratedQuestionsActivity"
            android:exported="false" />

        <!-- Technical MCQ Result -->
        <activity
            android:name=".TechnicalMcqResultActivity"
            android:exported="false" />

        <!-- Interview Preparation -->
        <activity
            android:name=".InterviewPreparationActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Edit Profile -->
        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Profile -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false" />

        <!-- Dashboard -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false" />

        <!-- Sign Up -->
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Main Activity / Launcher -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>

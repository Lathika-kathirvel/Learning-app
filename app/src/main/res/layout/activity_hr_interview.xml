<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/hrScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="56dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <!-- TOOLBAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btnHRBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#E5E9F0"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="←"
                    android:textColor="#17243B"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="AUROMINDAI"
                    android:textColor="#F26722"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HR Interview"
                    android:textColor="#17243B"
                    android:textSize="19sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>

        <!-- HERO CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#17243B"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="AI-POWERED HR PRACTICE"
                    android:textColor="#FFB58F"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Be confident. Be interview-ready."
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:lineSpacingExtra="4dp"
                    android:text="Practise HR questions, improve your communication and prepare for real interviews."
                    android:textColor="#D7DFEA"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="#253550"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="✦  PERSONALIZED HR PREPARATION"
                    android:textColor="#FFD0B7"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- QUESTION CATEGORIES -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="HR Question Categories"
            android:textColor="#17243B"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Choose what you want to practise."
            android:textColor="#788397"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#E8EBF1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbIntroduction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Self Introduction"
                    android:textColor="#17243B"
                    android:textSize="14sp"
                    app:buttonTint="#F26722" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbPersonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Personal &amp; Background Questions"
                    android:textColor="#17243B"
                    android:textSize="14sp"
                    app:buttonTint="#F26722" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbStrengths"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Strengths &amp; Weaknesses"
                    android:textColor="#17243B"
                    android:textSize="14sp"
                    app:buttonTint="#F26722" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbSituational"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Situational Questions"
                    android:textColor="#17243B"
                    android:textSize="14sp"
                    app:buttonTint="#F26722" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbCompany"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Company &amp; Job Role Questions"
                    android:textColor="#17243B"
                    android:textSize="14sp"
                    app:buttonTint="#F26722" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbSalary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Salary &amp; Career Goals"
                    android:textColor="#17243B"
                    android:textSize="14sp"
                    app:buttonTint="#F26722" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DIFFICULTY LEVEL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Difficulty Level"
            android:textColor="#17243B"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Select the complexity of questions."
            android:textColor="#788397"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#E8EBF1"
            app:strokeWidth="1dp">

            <RadioGroup
                android:id="@+id/rgHRDifficulty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RadioButton
                    android:id="@+id/rbHREasy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:paddingStart="8dp"
                    android:text="Easy"
                    android:textColor="#17243B"
                    android:textSize="14sp"
                    app:buttonTint="#F26722" />

                <RadioButton
                    android:id="@+id/rbHRMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="Medium"
                    android:textColor="#17243B"
                    android:textSize="14sp"
                    app:buttonTint="#F26722" />

                <RadioButton
                    android:id="@+id/rbHRHard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="8dp"
                    android:text="Hard"
                    android:textColor="#17243B"
                    android:textSize="14sp"
                    app:buttonTint="#F26722" />

            </RadioGroup>
        </com.google.android.material.card.MaterialCardView>

        <!-- RESUME UPLOAD -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Add Your Resume"
            android:textColor="#17243B"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="3dp"
            android:text="Upload your PDF resume so AI can personalize HR questions based on your skills, education and experience."
            android:textColor="#788397"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHRResume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#E8EBF1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        app:cardBackgroundColor="#FFF0E8"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#FFDAC8"
                        app:strokeWidth="1dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="PDF"
                            android:textColor="#F26722"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Resume (PDF only)"
                            android:textColor="#17243B"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Maximum file size: 5 MB"
                            android:textColor="#8993A3"
                            android:textSize="12sp" />

                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHRResumeFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="No resume selected"
                    android:textColor="#788397"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHRUploadResume"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="12dp"
                    android:text="Choose Resume PDF"
                    android:textAllCaps="false"
                    android:textColor="#F26722"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFF0E8"
                    app:cornerRadius="12dp"
                    app:strokeColor="#F26722"
                    app:strokeWidth="1dp" />

                <TextView
                    android:id="@+id/tvHRResumeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Optional • Upload a PDF to get resume-based HR questions"
                    android:textColor="#8993A3"
                    android:textSize="12sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- GENERATE BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerateHR"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="26dp"
            android:text="Generate HR Questions  →"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#F26722"
            app:cornerRadius="15dp" />

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="AUROMINDAI  •  Your AI-powered interview partner"
            android:textColor="#9AA3B2"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
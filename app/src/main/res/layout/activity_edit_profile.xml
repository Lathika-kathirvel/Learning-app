<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editProfileScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:descendantFocusability="afterDescendants"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- TOP TOOLBAR -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="14dp"
                app:cardElevation="1dp"
                app:strokeColor="#E5E9F0"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/btnEditBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="‹"
                    android:textColor="#17243B"
                    android:textSize="34sp"
                    android:contentDescription="Go back"/>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUROMINDAI"
                    android:textColor="#F26722"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.14"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Edit Profile"
                    android:textColor="#17243B"
                    android:textSize="21sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <!-- HERO HEADER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#17243B"
            app:cardCornerRadius="22dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="23dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BUILD YOUR INTERVIEW PROFILE"
                    android:textColor="#FFD0B7"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Tell us about yourself"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Share your skills and experience to get personalized mock interviews."
                    android:textColor="#D5DCE8"
                    android:textSize="13sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PERSONAL DETAILS HEADING -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:text="Personal Details"
            android:textColor="#17243B"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your basic account information"
            android:textColor="#697586"
            android:textSize="12sp"/>

        <!-- PERSONAL DETAILS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="#E5E9F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- FULL NAME -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Full Name"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxCornerRadiusTopStart="13dp"
                    app:boxCornerRadiusTopEnd="13dp"
                    app:boxCornerRadiusBottomStart="13dp"
                    app:boxCornerRadiusBottomEnd="13dp"
                    app:boxStrokeColor="#F26722"
                    app:hintTextColor="#697586">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEditName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:singleLine="true"
                        android:textColor="#17243B"
                        android:textColorHint="#8993A3"
                        android:textSize="15sp"
                        android:fontFamily="sans"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- EMAIL ADDRESS -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="19dp"
                    android:layout_marginBottom="8dp"
                    android:text="Email Address"
                    android:textColor="#4B5565"
                    android:textSize="13sp"
                    android:textStyle="bold"/>

                <EditText
                    android:id="@+id/etEditEmail"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:background="@drawable/edit_text_background"
                    android:clickable="false"
                    android:cursorVisible="false"
                    android:focusable="false"
                    android:fontFamily="sans"
                    android:inputType="textEmailAddress"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#697586"
                    android:textColorHint="#8993A3"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Your registered email cannot be changed here."
                    android:textColor="#8993A3"
                    android:textSize="11sp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- PROFESSIONAL DETAILS HEADING -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="27dp"
            android:text="Professional Details"
            android:textColor="#17243B"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Help us understand your career background"
            android:textColor="#697586"
            android:textSize="12sp"/>

        <!-- PROFESSIONAL DETAILS CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:strokeColor="#E5E9F0"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- SKILLS -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Skills"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxCornerRadiusTopStart="13dp"
                    app:boxCornerRadiusTopEnd="13dp"
                    app:boxCornerRadiusBottomStart="13dp"
                    app:boxCornerRadiusBottomEnd="13dp"
                    app:boxStrokeColor="#F26722"
                    app:hintTextColor="#697586">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etSkills"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textCapSentences|textMultiLine"
                        android:minHeight="65dp"
                        android:paddingTop="16dp"
                        android:textColor="#17243B"
                        android:textColorHint="#8993A3"
                        android:textSize="14sp"
                        android:fontFamily="sans"/>

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="20dp"
                    android:text="Separate multiple skills using commas."
                    android:textColor="#8993A3"
                    android:textSize="11sp"/>

                <!-- EXPERIENCE LEVEL -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Experience Level"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxCornerRadiusTopStart="13dp"
                    app:boxCornerRadiusTopEnd="13dp"
                    app:boxCornerRadiusBottomStart="13dp"
                    app:boxCornerRadiusBottomEnd="13dp"
                    app:boxStrokeColor="#F26722"
                    app:endIconMode="dropdown_menu"
                    app:hintTextColor="#697586">

                    <AutoCompleteTextView
                        android:id="@+id/actExperienceLevel"
                        android:layout_width="match_parent"
                        android:layout_height="58dp"
                        android:background="@android:color/transparent"
                        android:clickable="true"
                        android:focusable="false"
                        android:inputType="none"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:textColor="#17243B"
                        android:textColorHint="#8993A3"
                        android:textSize="15sp"
                        android:fontFamily="sans"
                        android:popupBackground="#FFFFFF"
                        android:dropDownVerticalOffset="4dp"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- EDUCATION -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="Education"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxCornerRadiusTopStart="13dp"
                    app:boxCornerRadiusTopEnd="13dp"
                    app:boxCornerRadiusBottomStart="13dp"
                    app:boxCornerRadiusBottomEnd="13dp"
                    app:boxStrokeColor="#F26722"
                    app:hintTextColor="#697586">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEducation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:singleLine="true"
                        android:textColor="#17243B"
                        android:textColorHint="#8993A3"
                        android:textSize="14sp"
                        android:fontFamily="sans"/>

                </com.google.android.material.textfield.TextInputLayout>

                <!-- TARGET JOB ROLE -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:hint="Target Job Role"
                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="#FFFFFF"
                    app:boxCornerRadiusTopStart="13dp"
                    app:boxCornerRadiusTopEnd="13dp"
                    app:boxCornerRadiusBottomStart="13dp"
                    app:boxCornerRadiusBottomEnd="13dp"
                    app:boxStrokeColor="#F26722"
                    app:hintTextColor="#697586">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTargetRole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:singleLine="true"
                        android:textColor="#17243B"
                        android:textColorHint="#8993A3"
                        android:textSize="14sp"
                        android:fontFamily="sans"/>

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- SAVE BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveProfile"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#F26722"
            android:text="Save Profile"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF"/>

        <!-- FOOTER -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="AUROMINDAI"
            android:textColor="#17243B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="Your AI-powered interview partner"
            android:textColor="#697586"
            android:textSize="11sp"/>

    </LinearLayout>

</ScrollView>
